# LOCAL DEVELOPMENT EXAMPLE ONLY: copy to .streamlit/secrets.toml
# .streamlit/secrets.toml is gitignored. Never commit actual credentials.
# In Streamlit Community Cloud, paste these fields into your app's private
# Settings -> Secrets instead of uploading this file.
#
# Use distinct credentials for local development and the shared deployment.
OPENAI_API_KEY = "REPLACE_WITH_YOUR_OWN_AUTHORIZED_KEY"
OPENAI_MODEL = "REPLACE_WITH_A_SUPPORTED_WEB_SEARCH_MODEL"
